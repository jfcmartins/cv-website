---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Jorge Martins — Staff Site Reliability Engineer. Cloud infrastructure, Kubernetes, and reliability engineering.',
} = Astro.props;

// Strip the trailing slash so `${base}/path` never doubles up, whether
// base is "/" (root deploys) or "/<repo>/" (GitHub Pages subpath, see
// site.config.mjs).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImage = new URL(`${base}/images/avatar.jpg`, Astro.site).toString();

const nav = [
  { href: `${base}/`, label: 'Home' },
  { href: `${base}/#skills`, label: 'Skills' },
  { href: `${base}/#experience`, label: 'Experience' },
  { href: `${base}/blog`, label: 'Blog' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f9d68" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />

    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap site-header-inner">
        <a href={`${base}/`} class="brand">
          <span class="dot"></span>
          Jorge Martins
        </a>
        <div class="header-controls">
          <nav class="nav">
            {nav.map((item) => (
              <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>{item.label}</a>
            ))}
          </nav>
          <button id="theme-toggle" class="theme-toggle" aria-label="Toggle color theme" type="button">
            <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </button>
          <button id="menu-toggle" class="menu-toggle theme-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-nav" type="button">
            <svg class="icon-menu" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            <svg class="icon-close" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
      </div>
      <nav id="mobile-nav" class="mobile-nav" hidden>
        <div class="wrap">
          {nav.map((item) => (
            <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>{item.label}</a>
          ))}
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer-inner">
        <p class="muted">© {new Date().getFullYear()} Jorge Martins</p>
      </div>
    </footer>

    <style>
      .site-header {
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: blur(8px);
        z-index: 10;
      }

      .site-header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block: 1rem;
      }

      .brand {
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--text);
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
      }

      .brand:hover {
        text-decoration: none;
      }

      .header-controls {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .nav {
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }

      .nav a {
        color: var(--text-muted);
        font-size: 0.92rem;
        font-weight: 500;
      }

      .nav a:hover {
        color: var(--text);
        text-decoration: none;
      }

      .theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        flex: none;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--bg-elevated);
        color: var(--text-muted);
        cursor: pointer;
      }

      .theme-toggle:hover {
        color: var(--text);
        border-color: var(--accent);
      }

      .icon-moon {
        display: none;
      }

      :root[data-theme='dark'] .icon-sun {
        display: none;
      }

      :root[data-theme='dark'] .icon-moon {
        display: block;
      }

      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) .icon-sun {
          display: none;
        }
        :root:not([data-theme='light']) .icon-moon {
          display: block;
        }
      }

      .menu-toggle {
        display: none;
      }

      .icon-close {
        display: none;
      }

      .menu-toggle[aria-expanded='true'] .icon-menu {
        display: none;
      }

      .menu-toggle[aria-expanded='true'] .icon-close {
        display: block;
      }

      .mobile-nav {
        display: none;
      }

      .mobile-nav .wrap {
        display: flex;
        flex-direction: column;
        padding-block: 0.5rem 1rem;
        border-top: 1px solid var(--border);
      }

      .mobile-nav a {
        color: var(--text-muted);
        font-size: 0.98rem;
        font-weight: 500;
        padding-block: 0.7rem;
      }

      .mobile-nav a:hover {
        color: var(--text);
        text-decoration: none;
      }

      /* Below ~640px, "Jorge Martins" + all nav links no longer fit on one
         line (measured: brand + nav routinely exceed the viewport by the
         time it's phone-width) -- collapse into a hamburger menu instead
         of letting the row wrap or overflow. */
      @media (max-width: 640px) {
        .header-controls .nav {
          display: none;
        }

        .menu-toggle {
          display: inline-flex;
        }

        .mobile-nav:not([hidden]) {
          display: block;
        }
      }

      .site-footer {
        border-top: 1px solid var(--border);
        margin-top: 5rem;
      }

      .site-footer-inner {
        padding-block: 2rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        justify-content: center;
        text-align: center;
        font-size: 0.85rem;
      }

      .muted {
        color: var(--text-faint);
      }
    </style>

    <script is:inline>
      (function () {
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', function () {
          const root = document.documentElement;
          const current = root.getAttribute('data-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const currentlyDark = current ? current === 'dark' : prefersDark;
          const next = currentlyDark ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch (e) {}
        });
      })();
    </script>

    <script is:inline>
      (function () {
        const toggle = document.getElementById('menu-toggle');
        const menu = document.getElementById('mobile-nav');
        if (!toggle || !menu) return;

        function closeMenu() {
          menu.hidden = true;
          toggle.setAttribute('aria-expanded', 'false');
        }

        toggle.addEventListener('click', function () {
          const isOpen = toggle.getAttribute('aria-expanded') === 'true';
          if (isOpen) {
            closeMenu();
          } else {
            menu.hidden = false;
            toggle.setAttribute('aria-expanded', 'true');
          }
        });

        menu.addEventListener('click', function (e) {
          if (e.target.closest('a')) closeMenu();
        });

        window.addEventListener('resize', function () {
          if (window.innerWidth > 640) closeMenu();
        });
      })();
    </script>

    <script is:inline>
      // scroll-behavior:smooth on <html> breaks Chrome's native jump-to-#hash
      // on initial page load, so that's left instant (see global.css). This
      // restores a smooth scroll, but only for same-page anchor clicks.
      (function () {
        document.addEventListener('click', function (e) {
          const link = e.target.closest('a[href*="#"]');
          if (!link) return;
          let url;
          try {
            url = new URL(link.href, location.href);
          } catch (err) {
            return;
          }
          if (url.pathname !== location.pathname || !url.hash) return;
          const target = document.getElementById(url.hash.slice(1));
          if (!target) return;
          e.preventDefault();
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
          history.pushState(null, '', url.hash);
        });
      })();
    </script>
  </body>
</html>
