---
import Layout from '../layouts/Layout.astro';
import {
  profile,
  highlights,
  certifications,
  skills,
  experience,
  education,
  languages,
} from '../data/resume';
import { getCollection } from 'astro:content';
import { GITHUB_USERNAME, LINKEDIN_USERNAME } from '../../site.config.mjs';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Brand marks (Simple Icons), used to give each certification its actual
// technology logo instead of a generic checkmark.
const certIcons = {
  kubernetes: {
    fill: '#326CE5',
    path: 'M10.204 14.35l.007.01-.999 2.413a5.171 5.171 0 0 1-2.075-2.597l2.578-.437.004.005a.44.44 0 0 1 .484.606zm-.833-2.129a.44.44 0 0 0 .173-.756l.002-.011L7.585 9.7a5.143 5.143 0 0 0-.73 3.255l2.514-.725.002-.009zm1.145-1.98a.44.44 0 0 0 .699-.337l.01-.005.15-2.62a5.144 5.144 0 0 0-3.01 1.442l2.147 1.523.004-.002zm.76 2.75l.723.349.722-.347.18-.78-.5-.623h-.804l-.5.623.179.779zm1.5-3.095a.44.44 0 0 0 .7.336l.008.003 2.134-1.513a5.188 5.188 0 0 0-2.992-1.442l.148 2.615.002.001zm10.876 5.97l-5.773 7.181a1.6 1.6 0 0 1-1.248.594l-9.261.003a1.6 1.6 0 0 1-1.247-.596l-5.776-7.18a1.583 1.583 0 0 1-.307-1.34L2.1 5.573c.108-.47.425-.864.863-1.073L11.305.513a1.606 1.606 0 0 1 1.385 0l8.345 3.985c.438.209.755.604.863 1.073l2.062 8.955c.108.47-.005.963-.308 1.34zm-3.289-2.057c-.042-.01-.103-.026-.145-.034-.174-.033-.315-.025-.479-.038-.35-.037-.638-.067-.895-.148-.105-.04-.18-.165-.216-.216l-.201-.059a6.45 6.45 0 0 0-.105-2.332 6.465 6.465 0 0 0-.936-2.163c.052-.047.15-.133.177-.159.008-.09.001-.183.094-.282.197-.185.444-.338.743-.522.142-.084.273-.137.415-.242.032-.024.076-.062.11-.089.24-.191.295-.52.123-.736-.172-.216-.506-.236-.745-.045-.034.027-.08.062-.111.088-.134.116-.217.23-.33.35-.246.25-.45.458-.673.609-.097.056-.239.037-.303.033l-.19.135a6.545 6.545 0 0 0-4.146-2.003l-.012-.223c-.065-.062-.143-.115-.163-.25-.022-.268.015-.557.057-.905.023-.163.061-.298.068-.475.001-.04-.001-.099-.001-.142 0-.306-.224-.555-.5-.555-.275 0-.499.249-.499.555l.001.014c0 .041-.002.092 0 .128.006.177.044.312.067.475.042.348.078.637.056.906a.545.545 0 0 1-.162.258l-.012.211a6.424 6.424 0 0 0-4.166 2.003 8.373 8.373 0 0 1-.18-.128c-.09.012-.18.04-.297-.029-.223-.15-.427-.358-.673-.608-.113-.12-.195-.234-.329-.349-.03-.026-.077-.062-.111-.088a.594.594 0 0 0-.348-.132.481.481 0 0 0-.398.176c-.172.216-.117.546.123.737l.007.005.104.083c.142.105.272.159.414.242.299.185.546.338.743.522.076.082.09.226.1.288l.16.143a6.462 6.462 0 0 0-1.02 4.506l-.208.06c-.055.072-.133.184-.215.217-.257.081-.546.11-.895.147-.164.014-.305.006-.48.039-.037.007-.09.02-.133.03l-.004.002-.007.002c-.295.071-.484.342-.423.608.061.267.349.429.645.365l.007-.001.01-.003.129-.029c.17-.046.294-.113.448-.172.33-.118.604-.217.87-.256.112-.009.23.069.288.101l.217-.037a6.5 6.5 0 0 0 2.88 3.596l-.09.218c.033.084.069.199.044.282-.097.252-.263.517-.452.813-.091.136-.185.242-.268.399-.02.037-.045.095-.064.134-.128.275-.034.591.213.71.248.12.556-.007.69-.282v-.002c.02-.039.046-.09.062-.127.07-.162.094-.301.144-.458.132-.332.205-.68.387-.897.05-.06.13-.082.215-.105l.113-.205a6.453 6.453 0 0 0 4.609.012l.106.192c.086.028.18.042.256.155.136.232.229.507.342.84.05.156.074.295.145.457.016.037.043.09.062.129.133.276.442.402.69.282.247-.118.341-.435.213-.71-.02-.039-.045-.096-.065-.134-.083-.156-.177-.261-.268-.398-.19-.296-.346-.541-.443-.793-.04-.13.007-.21.038-.294-.018-.022-.059-.144-.083-.202a6.499 6.499 0 0 0 2.88-3.622c.064.01.176.03.213.038.075-.05.144-.114.28-.104.266.039.54.138.87.256.154.06.277.128.448.173.036.01.088.019.13.028l.009.003.007.001c.297.064.584-.098.645-.365.06-.266-.128-.537-.423-.608zM16.4 9.701l-1.95 1.746v.005a.44.44 0 0 0 .173.757l.003.01 2.526.728a5.199 5.199 0 0 0-.108-1.674A5.208 5.208 0 0 0 16.4 9.7zm-4.013 5.325a.437.437 0 0 0-.404-.232.44.44 0 0 0-.372.233h-.002l-1.268 2.292a5.164 5.164 0 0 0 3.326.003l-1.27-2.296h-.01zm1.888-1.293a.44.44 0 0 0-.27.036.44.44 0 0 0-.214.572l-.003.004 1.01 2.438a5.15 5.15 0 0 0 2.081-2.615l-2.6-.44-.004.005z',
  },
  terraform: {
    fill: '#844FBA',
    path: 'M1.44 0v7.575l6.561 3.79V3.787zm21.12 4.227l-6.561 3.791v7.574l6.56-3.787zM8.72 4.23v7.575l6.561 3.787V8.018zm0 8.405v7.575L15.28 24v-7.578z',
  },
};

// One generic outline icon per skill category (not per tool) to give the
// grid some visual anchoring at a glance.
const skillIcons = {
  cloud: '<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9z"/>',
  layers:
    '<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>',
  refresh:
    '<polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>',
  activity: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>',
  database:
    '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
};
---

<Layout title={`${profile.name} — ${profile.role}`}>
  <section class="wrap hero">
    <div class="hero-text">
      <picture>
        <source srcset={`${base}/images/avatar.webp`} type="image/webp" />
        <img src={`${base}/images/avatar.jpg`} alt={profile.name} class="avatar" width="176" height="176" loading="eager" />
      </picture>
      <h1>{profile.name}</h1>
      <p class="role">{profile.role}</p>
      <div class="tag-row fields-row">
        {profile.fields.map((field) => (
          <span class="tag">{field}</span>
        ))}
      </div>
      <p class="summary">{profile.summary}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#experience">Experience</a>
        <a class="btn" href="#certifications">Certifications</a>
        <a class="btn" href={`${base}/files/Jorge-Martins-CV.pdf`} target="_blank" rel="noopener noreferrer">Download CV</a>
      </div>
    </div>

    <div class="terminal card" aria-hidden="true">
      <div class="terminal-bar">
        <span class="tdot tdot-r"></span>
        <span class="tdot tdot-y"></span>
        <span class="tdot tdot-g"></span>
        <span class="terminal-title mono">jorge@fabric-health</span>
      </div>
      <pre class="terminal-body mono"><code><span class="prompt">$</span> whoami
{profile.role}

<span class="prompt">$</span> cat fields.txt
{profile.fields.join(' · ')}

<span class="prompt">$</span> uptime
8+ years, no unplanned downtime

<span class="prompt">$</span> cat location.txt
{profile.location}

<span class="prompt">$</span> kubectl config current-context
{profile.company}
<span class="cursor">_</span></code></pre>
    </div>
  </section>

  <section class="wrap highlights">
    {highlights.map((h) => (
      <div class="card highlight">
        <div class="highlight-value mono">{h.value}</div>
        <div class="highlight-label">{h.label}</div>
      </div>
    ))}
  </section>

  <hr class="rule wrap" />

  <section class="wrap" id="skills">
    <h2 class="section-title">Skills & technologies</h2>
    <div class="skills-grid">
      {skills.map((group) => (
        <div class="card skill-card">
          <h3>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="skill-icon" set:html={skillIcons[group.icon]} />
            {group.category}
          </h3>
          <div class="tag-row">
            {group.items.map((item) => (
              <span class="tag">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <hr class="rule wrap" />

  <section class="wrap" id="certifications">
    <h2 class="section-title">Certifications</h2>
    <div class="cert-row">
      {certifications.map((c) => (
        <div class="cert card">
          <svg width="20" height="20" viewBox="0 0 24 24" fill={certIcons[c.icon].fill} class="cert-icon"><path d={certIcons[c.icon].path} /></svg>
          <div>
            <div class="cert-name">{c.name}</div>
            <div class="cert-issuer muted">{c.issuer}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <hr class="rule wrap" />

  <section class="wrap" id="experience">
    <h2 class="section-title">Experience</h2>
    <div class="timeline">
      {experience.map((entry) => (
        entry.roles.length === 1 ? (
          <article class="job">
            <div class="job-header">
              <div class="job-title-row">
                {entry.logo && <img class="company-logo" src={`${base}${entry.logo}`} alt="" width="32" height="32" loading="lazy" />}
                <div>
                  <h3>{entry.roles[0].title}</h3>
                  <p class="job-meta">{entry.company} · {entry.location}</p>
                </div>
              </div>
              <p class="job-period mono">{entry.roles[0].period}</p>
            </div>
            {entry.roles[0].note && <p class="job-note">{entry.roles[0].note}</p>}
            <ul>
              {entry.roles[0].bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </article>
        ) : (
          <article class="job">
            <div class="job-header">
              <div class="job-title-row">
                {entry.logo && <img class="company-logo" src={`${base}${entry.logo}`} alt="" width="32" height="32" loading="lazy" />}
                <div>
                  <h3>{entry.company}</h3>
                  <p class="job-meta">{entry.location}</p>
                </div>
              </div>
            </div>
            <div class="role-track">
              {entry.roles.map((role) => (
                <div class="role-item">
                  <div class="role-header">
                    <h4>{role.title}</h4>
                    <p class="job-period mono">{role.period}</p>
                  </div>
                  {role.note && <p class="job-note">{role.note}</p>}
                  <ul>
                    {role.bullets.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </article>
        )
      ))}
    </div>
  </section>

  <hr class="rule wrap" />

  <section class="wrap edu-lang">
    <div>
      <h2 class="section-title">Education</h2>
      {education.map((e) => (
        <div class="edu-item">
          <div class="job-title-row">
            {e.logo && <img class="company-logo" src={`${base}${e.logo}`} alt="" width="24" height="24" loading="lazy" />}
            <p class="edu-degree">{e.degree}</p>
          </div>
          <p class="muted">{e.school}</p>
          <p class="mono muted small">{e.period}</p>
        </div>
      ))}
    </div>
    <div>
      <h2 class="section-title">Languages</h2>
      <ul class="lang-list">
        {languages.map((l) => (
          <li><span aria-hidden="true">{l.flag}</span> <strong>{l.name}</strong> <span class="muted">— {l.level}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <hr class="rule wrap" />

  <section class="wrap">
    <h2 class="section-title">Hobbies</h2>
    <div class="cert-row">
      <div class="cert card">
        <span class="cert-icon hobby-emoji" aria-hidden="true">🏃</span>
        <div>
          <div class="cert-name">Running</div>
          <div class="cert-issuer muted">Long runs to clear my head</div>
        </div>
      </div>
      <div class="cert card">
        <span class="cert-icon hobby-emoji" aria-hidden="true">🏋️</span>
        <div>
          <div class="cert-name">Gym</div>
          <div class="cert-issuer muted">Consistency over intensity</div>
        </div>
      </div>
      <div class="cert card">
        <span class="cert-icon hobby-emoji" aria-hidden="true">🏄</span>
        <div>
          <div class="cert-name">Surfing & the beach</div>
          <div class="cert-issuer muted">Chasing swells whenever the ocean cooperates</div>
        </div>
      </div>
      <div class="cert card">
        <span class="cert-icon hobby-emoji" aria-hidden="true">🎬</span>
        <div>
          <div class="cert-name">Movies & old series</div>
          <div class="cert-issuer muted">Old favorites that take me back</div>
        </div>
      </div>
      <div class="cert card">
        <span class="cert-icon hobby-emoji" aria-hidden="true">📺</span>
        <div>
          <div class="cert-name">Tech & construction content</div>
          <div class="cert-issuer muted">Documentaries and videos on how things get built</div>
        </div>
      </div>
      <div class="cert card">
        <span class="cert-icon hobby-emoji" aria-hidden="true">🛠️</span>
        <div>
          <div class="cert-name">Building things</div>
          <div class="cert-issuer muted">Homelab and infra projects in my own time</div>
        </div>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <>
      <hr class="rule wrap" />
      <section class="wrap">
        <div class="section-header-row">
          <div>
            <p class="eyebrow">Reliability Notes</p>
            <h2 class="section-title">From the blog</h2>
          </div>
          <a class="btn" href={`${base}/blog`}>All posts</a>
        </div>
        <div class="post-grid">
          {posts.map((post) => (
            <a class="card post-card" href={`${base}/blog/${post.id}/`}>
              <p class="mono muted small">{post.data.pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })}</p>
              <h3>{post.data.title}</h3>
              <p class="muted">{post.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    </>
  )}

  <hr class="rule wrap" />

  <section class="wrap contact" id="contact">
    <h2 class="section-title">Get in touch</h2>
    <div class="cta-row">
      <a class="btn" href={`mailto:${profile.email}`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#EA4335" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>
        {profile.email}
      </a>
      <a class="btn" href={profile.linkedin} target="_blank" rel="noopener noreferrer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="#0A66C2"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.86 0-2.15 1.45-2.15 2.94v5.66H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
        linkedin.com/in/{LINKEDIN_USERNAME}
      </a>
      <a class="btn" href={profile.github} target="_blank" rel="noopener noreferrer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.73.5.98 5.24.98 11.5c0 5.01 3.29 9.26 7.86 10.76.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.2.7-3.87-1.36-3.87-1.36-.53-1.33-1.29-1.69-1.29-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.19 1.78 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.17.91-.25 1.89-.38 2.86-.39.97.01 1.95.14 2.86.39 2.18-1.48 3.15-1.17 3.15-1.17.62 1.59.23 2.76.11 3.05.73.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .3.21.66.79.55A10.52 10.52 0 0 0 23 11.5C23 5.24 18.27.5 12 .5z"/></svg>
        github.com/{GITHUB_USERNAME}
      </a>
    </div>
  </section>

  <style>
    .hero {
      padding-block: 4rem 2.5rem;
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 2.5rem;
      align-items: center;
    }

    .hero h1 {
      font-size: clamp(2.2rem, 5vw, 3rem);
      margin: 0 0 0.1rem;
    }

    .avatar {
      width: 88px;
      height: 88px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--border);
      margin-bottom: 1.1rem;
      display: block;
    }

    .terminal {
      overflow: hidden;
      font-size: 0.85rem;
    }

    .terminal-bar {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.6rem 0.8rem;
      border-bottom: 1px solid var(--border);
      background: var(--bg-inset);
    }

    .tdot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      display: inline-block;
    }

    .tdot-r { background: #ff5f56; }
    .tdot-y { background: #ffbd2e; }
    .tdot-g { background: #27c93f; }

    .terminal-title {
      margin-left: 0.5rem;
      color: var(--text-faint);
      font-size: 0.78rem;
    }

    .terminal-body {
      margin: 0;
      padding: 1.1rem 1.2rem;
      border: none;
      border-radius: 0;
      background: transparent;
      color: var(--text-muted);
      line-height: 1.7;
      white-space: pre-wrap;
      word-break: break-word;
    }

    .terminal-body .prompt {
      color: var(--accent-strong);
      font-weight: 600;
    }

    .terminal-body .cursor {
      color: var(--accent-strong);
      animation: blink 1.1s steps(1) infinite;
    }

    @keyframes blink {
      50% { opacity: 0; }
    }

    @media (max-width: 760px) {
      .hero {
        grid-template-columns: 1fr;
      }
    }

    .role {
      font-size: 1.2rem;
      color: var(--text-muted);
      font-weight: 600;
      margin: 0 0 0.7rem;
    }

    .fields-row {
      margin-bottom: 1.1rem;
    }

    .summary {
      max-width: 62ch;
      color: var(--text-muted);
      font-size: 1.02rem;
    }

    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 1.5rem;
    }

    .highlights {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 0.9rem;
      margin-top: 1rem;
    }

    .highlight {
      padding: 1.2rem;
      text-align: center;
    }

    .highlight-value {
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--accent-strong);
    }

    .highlight-label {
      color: var(--text-muted);
      font-size: 0.85rem;
      margin-top: 0.35rem;
    }

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
    }

    .skill-card {
      padding: 1.1rem 1.2rem;
    }

    .skill-card h3 {
      margin: 0 0 0.7rem;
      font-size: 0.98rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .skill-icon {
      color: var(--accent-strong);
      flex: none;
    }

    .tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .cert-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 0.9rem;
    }

    .cert {
      padding: 0.9rem 1.1rem;
      display: flex;
      align-items: flex-start;
      gap: 0.7rem;
    }

    .cert-icon {
      color: var(--accent-strong);
      margin-top: 0.15rem;
      flex: none;
    }

    .hobby-emoji {
      font-size: 1.3rem;
      line-height: 1;
      margin-top: 0;
    }

    .cert-name {
      font-weight: 600;
      font-size: 0.92rem;
    }

    .cert-issuer {
      font-size: 0.82rem;
    }

    .timeline {
      display: flex;
      flex-direction: column;
      gap: 2.2rem;
    }

    .job-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
