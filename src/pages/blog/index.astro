---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Blog — Jorge Martins" description="Notes on site reliability, Kubernetes, and cloud infrastructure.">
  <section class="wrap header">
    <p class="eyebrow"><span class="dot"></span> Reliability Notes</p>
    <h1>Blog</h1>
    <p class="summary">Field notes on SRE, Kubernetes, cloud infrastructure, and the occasional incident post-mortem.</p>
  </section>

  <section class="wrap posts">
    {posts.length === 0 && <p class="muted">No posts yet — check back soon.</p>}
    {posts.map((post) => (
      <a class="card post" href={`${base}/blog/${post.id}/`}>
        <p class="mono muted small">
          {post.data.pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })}
        </p>
        <h2>{post.data.title}</h2>
        <p class="muted">{post.data.description}</p>
        {post.data.tags.length > 0 && (
          <div class="tag-row">
            {post.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </a>
    ))}
  </section>

  <style>
    .header {
      padding-block: 3rem 1rem;
    }

    .header h1 {
      margin: 0.5rem 0 0.6rem;
      font-size: clamp(2rem, 4vw, 2.6rem);
    }

    .summary {
      color: var(--text-muted);
      max-width: 60ch;
    }

    .posts {
      padding-bottom: 3rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .post {
      display: block;
      padding: 1.3rem 1.4rem;
      color: var(--text);
    }

    .post:hover {
      text-decoration: none;
      border-color: var(--accent);
    }

    .post h2 {
      margin: 0.3rem 0 0.5rem;
      font-size: 1.15rem;
    }

    .small {
      font-size: 0.8rem;
    }

    .tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: 0.8rem;
    }
  </style>
</Layout>
